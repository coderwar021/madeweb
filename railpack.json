{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "node": "22"
  },
  "steps": {
    "build": {
      "commands": [
        "...",
        "npm install -g npm@11.16.0",
        "npm ci --prefix apps/web",
        "npm run build --prefix apps/web"
      ]
    }
  },
  "deploy": {
    "startCommand": "PYTHONPATH=/app/services/api:/app/packages/schema:/app/packages/security /app/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"
  }
}
